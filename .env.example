# === Gemini API (obrigatório) ===
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash   # opcional, este é o padrão
LOG_LEVEL=INFO                   # opcional: DEBUG, INFO, WARNING
DSPY_CACHEDIR=                   # opcional, padrão: .cache/dspy

# === Langfuse (opcional — observabilidade) ===
# Suba a instância local com: docker compose up -d
# Acesse http://localhost:3010, crie uma conta e gere as chaves em Settings → API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3010
